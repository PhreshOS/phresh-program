    "version": "0.1.27",
    "description": "The official PhreshOS starter Program.",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "check": "tsc --noEmit",
        "build": "vite-node scripts/build.ts",
