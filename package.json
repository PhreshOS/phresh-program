    },
    "homepage": "https://github.com/PhreshOS/phresh-program#readme",
    "keywords": [
        "phreshos",
        "program",
        "starter"
    ],
    "dependencies": {
        "@phreshos/client": "^0.1.32",
        "@phreshos/core": "^0.1.36",
        "@phreshos/react": "^0.1.18",
        "@phreshos/server": "^0.1.35",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
